{
  "name": "shopify-app-session-storage-kysely",
  "version": "0.2.0",
  "description": "Kysely-backed session storage adapter for Shopify apps, implementing @shopify/shopify-app-session-storage's SessionStorage interface.",
  "author": "Adriano Corte Real",
  "license": "MIT",
  "homepage": "https://github.com/adrianocr/shopify-app-session-storage-kysely#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianocr/shopify-app-session-storage-kysely.git"
  },
  "bugs": {
    "url": "https://github.com/adrianocr/shopify-app-session-storage-kysely/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "shopify",
    "session-storage",
    "kysely",
    "postgres"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@shopify/shopify-api": ">=11",
    "@shopify/shopify-app-session-storage": ">=4",
    "kysely": ">=0.28.17"
  },
  "devDependencies": {
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-session-storage": "^7.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
